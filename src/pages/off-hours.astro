---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
---

<Base
  title="Off hours — Hannah Arjonillo"
  description="Art, a recipe box that takes measurement seriously, and lists of favorite things."
>
  <Eyebrow>Off hours</Eyebrow>
  <h1 class="page-title">Things created & consumed</h1>

  <section>
    <div class="index-list">
      <a class="index-row" href="/art">
        <span class="index-name">Art</span>
        <span class="index-desc">Scans and photos of ink, watercolor, and acrylic pieces</span>
        <span class="index-arrow"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </a>
      <a class="index-row" href="/recipes">
        <span class="index-name">Recipes</span>
        <span class="index-desc">Measured in grams, with servings that scale themselves</span>
        <span class="index-arrow"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </a>
      <a class="index-row" href="/lists">
        <span class="index-name">Lists</span>
        <span class="index-desc">Films by director, TV &amp; anime, favorite humans, and where to eat in the Philippines</span>
        <span class="index-arrow"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </a>
    </div>
  </section>
</Base>
