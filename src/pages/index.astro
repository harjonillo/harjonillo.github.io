---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Eyebrow from '../components/Eyebrow.astro';

type Row = { label: string; date?: string; done?: boolean; ongoing?: boolean };

// Compact home checklists show only the current frontier: the most recent done
// item plus what's upcoming, capped at 3 rows. The full timeline lives on /research.
const frontier = (ms: Row[]): Row[] => {
  const lastDone = ms.filter((m) => m.done).slice(-1);
  const upcoming = ms.filter((m) => !m.done);
  return [...lastDone, ...upcoming].slice(0, 3);
};

// PhD card mirrors the "Current" card on /research — driven by the featured
// education entry so the two never drift.
const education = await getCollection('education');
const phd = education.find((e) => e.data.featured);
const phdMilestones: Row[] = phd ? frontier(phd.data.milestones) : [];

// Independent AI-safety work — most recently done + what's ongoing.
const aiMilestones: Row[] = [
  { label: 'BlueDot AGI Strategy', date: 'SEP 2026', done: true },
  { label: 'SPAR — Loss of Human Agency ABM', date: 'ongoing', ongoing: true },
];
---

<Base
  title="Hannah Arjonillo — data scientist · physics PhD researcher"
  description="Six years of production ML on physiological time-series, currently pursuing a Physics PhD on hyperspectral unmixing."
>
  <section class="hero">
    <Eyebrow>Data scientist · Physics PhD researcher · Metro Manila (GMT+8)</Eyebrow>
    <h1>Hannah Arjonillo</h1>
    <p class="lede">
      I am currently a Physics PhD Student into modeling complex social phenomena: specifically voting patterns as of now, but generally interested in the messy intersection of human behavior & culture, technology, information, and health. 
    </p>
    <p class="lede">  
      I also have six years of applied research and ML experience in biosignals, behavioral health language, EMRs. 
    </p>
    <p class="lede"> 
      I am actively exploring AI safety independently, with specific interests in human agency, shared reality, and everything else downstream.
    </p>
    <p class="lede"> 
      Outside of work, I love watching movies, painting, and learning piano études!
    </p>
    <div class="cta-row">
      {/* TODO: drop the real PDF into public/cv/ */}
      <a class="btn primary" href="/cv/hannah-arjonillo-cv.pdf">Download CV</a>
    </div>
  </section>

  <section class="currently">
    <Eyebrow>Currently</Eyebrow>
    <div class="grid3">
      <Card>
        <span class="meta">Work</span>
        <h3>Open to roles</h3>
        <p class="muted">Between roles right now — looking for my next full-time position.</p>
        <span class="pill status">
          <span class="status-dot" aria-hidden="true"></span>
          Open to full-time roles
        </span>
      </Card>
      <Card>
        <span class="meta">PhD</span>
        <h3>Physics PhD</h3>
        <p class="muted">Hyperspectral unmixing methodologies applied to Philippine senatorial voting patterns</p>
        {
          phdMilestones.length > 0 && (
            <ol class="milestones">
              {phdMilestones.map((m) => (
                <li class:list={['milestone', { done: m.done, ongoing: m.ongoing }]}>
                  <span class="tick" aria-hidden="true">{m.ongoing ? '▸' : m.done ? '✓' : '·'}</span>
                  <span class="label">{m.label}</span>
                  <span class="when">{m.date ?? '—'}</span>
                </li>
              ))}
            </ol>
          )
        }
      </Card>
      <Card>
        <span class="meta">Independent research</span>
        <h3>AI safety</h3>
        <p class="muted">Focused on my SPAR project and building my AI safety literacy.</p>
        <ol class="milestones">
          {aiMilestones.map((m) => (
            <li class:list={['milestone', { done: m.done, ongoing: m.ongoing }]}>
              <span class="tick" aria-hidden="true">{m.ongoing ? '▸' : m.done ? '✓' : '·'}</span>
              <span class="label">{m.label}</span>
              <span class="when">{m.date ?? '—'}</span>
            </li>
          ))}
        </ol>
      </Card>
    </div>
  </section>

  <section class="quick-cards">
    <Eyebrow>Explore</Eyebrow>
    <div class="grid2">
      <Card href="/work">
        <h3>Work</h3>
        <p class="muted">Data Science / ML / AI in healthcare</p>
      </Card>
      <Card href="/research">
        <h3>Research</h3>
        <p class="muted">Signals, spectra, and social systems</p>
      </Card>
      <Card href="/projects">
        <h3>Projects</h3>
        <p class="muted">Things you can click</p>
      </Card>
      <Card href="/off-hours">
        <h3>Off hours</h3>
        <p class="muted">Things created & consumed</p>
      </Card>
    </div>
  </section>
</Base>
