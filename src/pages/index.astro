---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Eyebrow from '../components/Eyebrow.astro';
---

<Base
  title="Hannah Arjonillo — data scientist · physics PhD researcher"
  description="Six years of production ML on physiological time-series, currently pursuing a Physics PhD on hyperspectral unmixing."
>
  <section class="hero">
    <Eyebrow>Data scientist · Physics PhD researcher · Metro Manila (GMT+8)</Eyebrow>
    <h1>Hannah Arjonillo</h1>
    <p class="lede">
      I am currently a Physics PhD Student into modeling complex social phenomena: specifically voting patterns as of now, but generally interested in the messy intersection of human behavior & culture, technology, information, and health. 
    </p>
    <p class="lede">  
      I also have six years of applied research and ML experience in biosignals, behavioral health language, EMRs. 
    </p>
    <p class="lede"> 
      I am actively exploring AI safety independently, with specific interests in human agency, shared reality, and everything else downstream.
    </p>
    <p class="lede"> 
      Outside of work, I love watching movies, painting, and learning piano études!
    </p>
    <div class="cta-row">
      {/* TODO: drop the real PDF into public/cv/ */}
      <a class="btn primary" href="/cv/hannah-arjonillo-cv.pdf">Download CV</a>
    </div>
  </section>

  <section class="quick-cards">
    <Eyebrow>Explore</Eyebrow>
    <div class="grid2">
      <Card href="/work">
        <h3>Work</h3>
        <p class="muted">Data Science / ML / AI in healthcare</p>
      </Card>
      <Card href="/research">
        <h3>Research</h3>
        <p class="muted">Signals, spectra, and social systems</p>
      </Card>
      <Card href="/projects">
        <h3>Projects</h3>
        <p class="muted">Things you can click</p>
      </Card>
      <Card href="/off-hours">
        <h3>Off hours</h3>
        <p class="muted">Things created & consumed</p>
      </Card>
    </div>
  </section>
</Base>
