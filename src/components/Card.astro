---
interface Props {
  href?: string;
  class?: string;
  id?: string;
}

const { href, class: className, id } = Astro.props;
---

{
  href ? (
    <a class:list={['card', className]} href={href} id={id}>
      <slot />
    </a>
  ) : (
    <div class:list={['card', className]} id={id}>
      <slot />
    </div>
  )
}
