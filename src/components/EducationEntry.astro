---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'education'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

{/* Reuses the .job grid styles — same dates-left, content-right layout. */}
<div class="job">
  <div class="meta">{entry.data.start} — {entry.data.end}</div>
  <div>
    <h3>{entry.data.institution}</h3>
    <p class="role">{entry.data.credential}</p>
    <div class="muted">
      <Content />
    </div>
    {entry.data.adviser && (
      <p class="muted adviser">Adviser: {entry.data.adviser}</p>
    )}
    {
      entry.data.coursework.length > 0 && (
        <div class="coursework">
          <span class="meta">Selected coursework</span>
          <ul>
            {entry.data.coursework.map((course) => (
              <li>
                {course.title}
                {course.note && <span class="note"> — {course.note}</span>}
                {course.inProgress && <span class="in-progress">in progress</span>}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</div>
