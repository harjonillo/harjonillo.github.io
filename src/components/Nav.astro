---
const links = [
  { href: '/', label: 'home' },
  { href: '/work', label: 'work' },
  { href: '/research', label: 'research & education' },
  { href: '/projects', label: 'projects' },
  // The off-hours wing: hub page plus its sub-pages all light up this tab.
  { href: '/off-hours', label: 'off hours', match: ['/off-hours', '/art', '/recipes', '/lists'] },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
// The hero already carries the name on the home page — hide the wordmark
// there but keep its space so the tabs don't shift between pages.
const isHome = path === '/';
const matches = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
const isCurrent = (link: (typeof links)[number]) =>
  (link.match ?? [link.href]).some(matches);
---

<header class="site-header">
  <nav aria-label="Site">
    <a
      class:list={['logo', { 'is-hidden': isHome }]}
      href="/"
      aria-hidden={isHome ? 'true' : undefined}
      tabindex={isHome ? -1 : undefined}
    >
      hannah arjonillo
    </a>
    {
      links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link) ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </button>
  </nav>
</header>

<script>
  // Flip between light and dark and remember the choice. Before the first
  // click, the current theme is whatever the system prefers.
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const current = () =>
    (root.dataset.theme as 'light' | 'dark' | undefined) ??
    (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const sync = () => {
    root.dataset.theme = current();
    button?.setAttribute('aria-pressed', String(current() === 'dark'));
  };
  sync();
  button?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
    sync();
  });
</script>
